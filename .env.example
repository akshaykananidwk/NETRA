# ══════════════════════════════════════════════════════════════
#  KRISHNA NETRA (કૃષ્ણ નેત્ર) — configuration
#  Copy this file to `.env` and edit the values.
#  Phase 1 uses the Server / Vision / Audio / Data sections.
# ══════════════════════════════════════════════════════════════

# --- Server ---
HOST=0.0.0.0
PORT=8000
UI_LANG=gu
TIMEZONE=Asia/Kolkata
WORK_HOURS_START=09:00
WORK_HOURS_END=21:00

# --- Vision ---
FACE_MODEL=buffalo_l
DETECTION_FPS=5
FACE_MATCH_THRESHOLD=0.55
FACE_UNCERTAIN_THRESHOLD=0.40
MIN_FACE_SIZE=80
DET_SCORE_MIN=0.65
MAX_YAW_DEG=45
GREET_COOLDOWN_HOURS=4
UNKNOWN_ASK_MAX_PER_DAY=2
UNKNOWN_DEDUPE_THRESHOLD=0.50
VISIT_MERGE_MINUTES=10
STREAM_FPS=10
USE_GPU=false

# --- Audio ---
MIC_DEVICE_INDEX=-1
SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
WAKE_WORD=krishna
WAKE_WORD_THRESHOLD=0.5
SPEAKER_MATCH_THRESHOLD=0.72

# --- STT ---
STT_ENGINE=faster-whisper
WHISPER_MODEL=medium
# medium is accurate but heavy on CPU; use "small" on a weaker laptop
WHISPER_LANGUAGE=gu
STT_CLOUD_FALLBACK=false
# transcribe all speech (true) or only while waiting for a reply (false)
STT_ALWAYS_ON=true
# seconds to wait for an unknown visitor to say their name
REPLY_TIMEOUT_SEC=12

# --- TTS ---
TTS_ENGINE=edge
EDGE_VOICE=gu-IN-DhwaniNeural
TTS_RATE=+5%
PIPER_MODEL_PATH=models/piper/gu_IN.onnx

# --- LLM (Phase 3) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SEC=8

# --- WhatsApp (Phase 3) ---
WA_API_BASE=https://bulk.akdwk.in/api
WA_API_KEY=
WA_DEVICE_ID=
WA_CANTEEN_NUMBER=
WA_ADMIN_NUMBER=
WA_TIMEOUT_SEC=10

# --- Data ---
SNAPSHOT_RETENTION_DAYS=90
MEETING_AUDIO_RETENTION_DAYS=180
DB_PATH=data/krishna.db
